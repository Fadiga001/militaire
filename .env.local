-- ===========================================================
-- BASE DE DONNÉES : systeme_facturation_agitel
-- ===========================================================

-- ========================
-- TABLE annees_academiques
-- ========================
CREATE TABLE annees_academiques (
    id_annee INT AUTO_INCREMENT PRIMARY KEY,
    libelle VARCHAR(20) NOT NULL,        -- ex: "2025-2026"
    date_debut DATE NOT NULL,
    date_fin DATE NOT NULL,
    statut ENUM('en cours', 'clôturée', 'future') DEFAULT 'en cours'
);

-- ========================
-- TABLE filieres
-- ========================
CREATE TABLE filieres (
    id_filiere INT AUTO_INCREMENT PRIMARY KEY,
    nom_filiere VARCHAR(100) NOT NULL,
    description TEXT
);

-- ========================
-- TABLE filiere_frais
-- ========================
CREATE TABLE filiere_frais (
    id_frais INT AUTO_INCREMENT PRIMARY KEY,
    id_filiere INT NOT NULL,
    id_annee INT NOT NULL,
    niveau VARCHAR(50) NOT NULL,                 -- ex: L1, L2, L3, etc.
    montant_total DECIMAL(12,2) NOT NULL,        -- Montant total de la scolarité
    date_creation DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (id_filiere) REFERENCES filieres(id_filiere),
    FOREIGN KEY (id_annee) REFERENCES annees_academiques(id_annee)
);

-- ========================
-- TABLE etudiants
-- ========================
CREATE TABLE etudiants (
    id_etudiant INT AUTO_INCREMENT PRIMARY KEY,
    matricule VARCHAR(50) UNIQUE NOT NULL,
    nom VARCHAR(100) NOT NULL,
    prenom VARCHAR(100) NOT NULL,
    contact VARCHAR(50),
    id_filiere INT NOT NULL,
    niveau VARCHAR(50),
    reduction DECIMAL(12,2) DEFAULT 0,           -- réduction individuelle
    id_annee INT NOT NULL,
    FOREIGN KEY (id_filiere) REFERENCES filieres(id_filiere),
    FOREIGN KEY (id_annee) REFERENCES annees_academiques(id_annee)
);

-- ========================
-- TABLE utilisateurs
-- ========================
CREATE TABLE utilisateurs (
    id_utilisateur INT AUTO_INCREMENT PRIMARY KEY,
    nom VARCHAR(100) NOT NULL,
    email VARCHAR(100) UNIQUE NOT NULL,
    mot_de_passe VARCHAR(255) NOT NULL,          -- mot de passe hashé
    role ENUM('comptable', 'admin', 'super_admin') DEFAULT 'comptable',
    statut ENUM('actif', 'inactif') DEFAULT 'actif',
    date_creation DATETIME DEFAULT CURRENT_TIMESTAMP,
    derniere_connexion DATETIME
);

-- ========================
-- TABLE paiements
-- ========================
CREATE TABLE paiements (
    id_paiement INT AUTO_INCREMENT PRIMARY KEY,
    id_etudiant INT NOT NULL,
    montant DECIMAL(12,2) NOT NULL,
    mode_paiement ENUM('BACI', 'CELPAID') NOT NULL,
    ref_transaction VARCHAR(100) NOT NULL,
    date_paiement DATETIME DEFAULT CURRENT_TIMESTAMP,
    date_expiration DATE, 
    id_annee INT NOT NULL,
    id_utilisateur INT NOT NULL,
    FOREIGN KEY (id_etudiant) REFERENCES etudiants(id_etudiant),
    FOREIGN KEY (id_annee) REFERENCES annees_academiques(id_annee),
    FOREIGN KEY (id_utilisateur) REFERENCES utilisateurs(id_utilisateur)
);

-- ========================
-- TABLE recus
-- ========================
CREATE TABLE recus (
    id_recu INT AUTO_INCREMENT PRIMARY KEY,
    id_paiement INT NOT NULL,
    numero_recu VARCHAR(50) UNIQUE NOT NULL,     -- ex: "AGI-2025-0001"
    date_generation DATETIME DEFAULT CURRENT_TIMESTAMP,                       -- période de validité du reçu
    url_pdf VARCHAR(255),
    statut ENUM('généré', 'annulé', 'expiré') DEFAULT 'généré',
    id_annee INT NOT NULL,
    id_utilisateur INT NOT NULL,
    FOREIGN KEY (id_paiement) REFERENCES paiements(id_paiement),
    FOREIGN KEY (id_annee) REFERENCES annees_academiques(id_annee),
    FOREIGN KEY (id_utilisateur) REFERENCES utilisateurs(id_utilisateur)
);

-- ========================
-- TABLE logs_activites
-- ========================
CREATE TABLE logs_activites (
    id_log INT AUTO_INCREMENT PRIMARY KEY,
    id_utilisateur INT NOT NULL,
    action VARCHAR(255) NOT NULL,
    details TEXT,
    date_action DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (id_utilisateur) REFERENCES utilisateurs(id_utilisateur)
);

-- ========================
-- VUE vue_scolarite_etudiant
-- ========================
CREATE OR REPLACE VIEW vue_scolarite_etudiant AS
SELECT 
    e.id_etudiant,
    e.matricule,
    e.nom,
    e.prenom,
    f.nom_filiere,
    e.niveau,
    a.libelle AS annee_academique,
    ff.montant_total AS scolarite_totale,
    e.reduction,
    (ff.montant_total - e.reduction) AS scolarite_apres_reduction,
    COALESCE(SUM(p.montant), 0) AS montant_paye,
    ((ff.montant_total - e.reduction) - COALESCE(SUM(p.montant), 0)) AS reste_a_payer
FROM etudiants e
JOIN filieres f ON e.id_filiere = f.id_filiere
JOIN filiere_frais ff 
    ON f.id_filiere = ff.id_filiere 
    AND e.niveau = ff.niveau 
    AND e.id_annee = ff.id_annee
JOIN annees_academiques a ON e.id_annee = a.id_annee
LEFT JOIN paiements p ON e.id_etudiant = p.id_etudiant
GROUP BY e.id_etudiant, ff.montant_total, e.reduction;
