DROP TRIGGER IF EXISTS `trg_condamnation_after_insert`;
DELIMITER $$
CREATE TRIGGER `trg_condamnation_after_insert` AFTER INSERT ON `condamnations` FOR EACH ROW BEGIN
    UPDATE detenus 
    SET nombre_condamnations = nombre_condamnations + 1,
        is_multrecidiviste = (nombre_condamnations + 1 > 1),
        statut_actuel = 'CONDAMNE'
    WHERE id = NEW.detenu_id;
END
$$
DELIMITER ;
DROP TRIGGER IF EXISTS `trg_condamnation_before_insert`;
DELIMITER $$
CREATE TRIGGER `trg_condamnation_before_insert` BEFORE INSERT ON `condamnations` FOR EACH ROW BEGIN
    DECLARE v_categorie VARCHAR(20);
    
    -- Récupérer la catégorie de l'infraction
    SELECT categorie INTO v_categorie
    FROM infractions
    WHERE id = NEW.infraction_id;
    
    -- Déterminer si c'est une détention préventive
    IF NEW.date_jugement IS NULL OR NEW.statut = 'EN_COURS' THEN
        SET NEW.est_en_detention_preventive = TRUE;
        
        -- Définir la durée max selon la catégorie
        IF v_categorie = 'CRIME' THEN
            SET NEW.duree_max_detention_preventive_mois = 24;
        ELSEIF v_categorie = 'DELIT' THEN
            SET NEW.duree_max_detention_preventive_mois = 18;
        ELSE
            SET NEW.duree_max_detention_preventive_mois = 6; -- Contravention
        END IF;
        
        -- Calculer la date limite
        IF NEW.date_mandat_depot IS NOT NULL THEN
            SET NEW.date_limite_detention_preventive = DATE_ADD(
                NEW.date_mandat_depot,
                INTERVAL NEW.duree_max_detention_preventive_mois MONTH
            );
        ELSEIF NEW.date_oip IS NOT NULL THEN
            SET NEW.date_limite_detention_preventive = DATE_ADD(
                NEW.date_oip,
                INTERVAL NEW.duree_max_detention_preventive_mois MONTH
            );
        END IF;
    END IF;
END
$$
DELIMITER ;
DROP TRIGGER IF EXISTS `trg_condamnation_before_update`;
DELIMITER $$
CREATE TRIGGER `trg_condamnation_before_update` BEFORE UPDATE ON `condamnations` FOR EACH ROW BEGIN
    IF NEW.date_jugement IS NOT NULL AND NEW.peine_valeur > 0 THEN
        -- Date théorique
        SET NEW.date_liberation_theorique = DATE_ADD(
            NEW.date_jugement, 
            INTERVAL NEW.peine_jours_total DAY
        );
        
        -- Jours OIP
        SET NEW.jours_detention_provisoire_oip = COALESCE(
            DATEDIFF(NEW.date_omlp, NEW.date_oip), 0
        );
        
        -- Jours mandat
        IF NEW.date_mandat_depot IS NOT NULL THEN
            SET NEW.jours_detention_provisoire_mandat = DATEDIFF(
                COALESCE(NEW.date_liberation_mandat, NEW.date_jugement),
                NEW.date_mandat_depot
            );
        ELSE
            SET NEW.jours_detention_provisoire_mandat = 0;
        END IF;
        
        -- Date effective
        SET NEW.date_liberation_effective = DATE_SUB(
            NEW.date_liberation_theorique,
            INTERVAL NEW.jours_detention_provisoire_total DAY
        );
    END IF;
END
$$
DELIMITER ;
DROP TRIGGER IF EXISTS `trg_condamnation_before_update_dp`;
DELIMITER $$
CREATE TRIGGER `trg_condamnation_before_update_dp` BEFORE UPDATE ON `condamnations` FOR EACH ROW BEGIN
    DECLARE v_categorie VARCHAR(20);
    
    -- Si le jugement est prononcé, ce n'est plus une détention préventive
    IF NEW.date_jugement IS NOT NULL AND OLD.date_jugement IS NULL THEN
        SET NEW.est_en_detention_preventive = FALSE;
    END IF;
    
    -- Recalculer la date limite si nécessaire
    IF NEW.est_en_detention_preventive = TRUE THEN
        SELECT categorie INTO v_categorie
        FROM infractions
        WHERE id = NEW.infraction_id;
        
        IF v_categorie = 'CRIME' THEN
            SET NEW.duree_max_detention_preventive_mois = 24;
        ELSEIF v_categorie = 'DELIT' THEN
            SET NEW.duree_max_detention_preventive_mois = 18;
        ELSE
            SET NEW.duree_max_detention_preventive_mois = 6;
        END IF;
        
        IF NEW.date_mandat_depot IS NOT NULL THEN
            SET NEW.date_limite_detention_preventive = DATE_ADD(
                NEW.date_mandat_depot,
                INTERVAL NEW.duree_max_detention_preventive_mois MONTH
            );
        ELSEIF NEW.date_oip IS NOT NULL THEN
            SET NEW.date_limite_detention_preventive = DATE_ADD(
                NEW.date_oip,
                INTERVAL NEW.duree_max_detention_preventive_mois MONTH
            );
        END IF;
        
        -- Définir le niveau d'alerte
        IF NEW.date_limite_detention_preventive < NOW() THEN
            SET NEW.alerte_detention_preventive = 'DEPASSEE';
        ELSEIF DATEDIFF(NEW.date_limite_detention_preventive, NOW()) <= 7 THEN
            SET NEW.alerte_detention_preventive = 'URGENT';
        ELSEIF DATEDIFF(NEW.date_limite_detention_preventive, NOW()) <= 30 THEN
            SET NEW.alerte_detention_preventive = 'ATTENTION';
        ELSE
            SET NEW.alerte_detention_preventive = 'NORMAL';
        END IF;
    END IF;
END
$$
DELIMITER ;

