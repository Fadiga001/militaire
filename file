DELIMITER $$
CREATE TRIGGER `trg_detention_provisoire_after_insert` AFTER INSERT ON `detentions_provisoires` FOR EACH ROW BEGIN
    -- Mettre le détenu en détention provisoire
    UPDATE detenus
    SET statut_actuel = 'DETENTION_PROVISOIRE',
        date_changement_statut = NOW()
    WHERE id = NEW.detenu_id;
    
    -- Créer une période de détention
    INSERT INTO periodes_detention (
        detenu_id,
        type,
