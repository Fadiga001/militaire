        nombre_condamnations = nombre_condamnations + 1,
        is_multrecidiviste = (nombre_condamnations + 1 > 1),
        date_changement_statut = NOW(),
        updated_by = p_user_id
    WHERE id = v_detenu_id;
    
    -- Fermer l'ancienne période et en créer une nouvelle
    UPDATE periodes_detention
    SET date_fin = p_date_jugement
    WHERE detenu_id = v_detenu_id
      AND type = 'DETENTION_PROVISOIRE'
      AND date_fin IS NULL;
    
