DROP TABLE IF EXISTS `v_condamnations_actives`;

DROP VIEW IF EXISTS `v_condamnations_actives`;
CREATE ALGORITHM=UNDEFINED DEFINER=`root`@`localhost` SQL SECURITY DEFINER VIEW `v_condamnations_actives`  AS SELECT `c`.`id` AS `id`, `c`.`numero_dossier` AS `numero_dossier`, `d`.`nom_complet` AS `detenu`, `d`.`matricule` AS `matricule`, `i`.`libelle` AS `infraction`, `c`.`date_jugement` AS `date_jugement`, concat(`c`.`peine_valeur`,' ',`c`.`peine_unite`) AS `peine`, `c`.`date_liberation_effective` AS `date_liberation_effective`, (to_days(`c`.`date_liberation_effective`) - to_days(now())) AS `jours_restants`, (case when (`c`.`date_liberation_effective` < now()) then 'LIBERABLE' when ((to_days(`c`.`date_liberation_effective`) - to_days(now())) <= 1) then 'CRITIQUE' when ((to_days(`c`.`date_liberation_effective`) - to_days(now())) <= 7) then 'URGENT' when ((to_days(`c`.`date_liberation_effective`) - to_days(now())) <= 14) then 'ATTENTION' when ((to_days(`c`.`date_liberation_effective`) - to_days(now())) <= 30) then 'A_SUIVRE' else 'NORMAL' end) AS `statut_alerte`, `l`.`nom` AS `lieu_detention`, `c`.`statut` AS `statut` FROM (((`condamnations` `c` join `detenus` `d` on((`c`.`detenu_id` = `d`.`id`))) join `infractions` `i` on((`c`.`infraction_id` = `i`.`id`))) left join `lieux_detention` `l` on((`c`.`lieu_detention_id` = `l`.`id`))) WHERE ((`c`.`statut` = 'EN_COURS') AND (`c`.`is_deleted` = false) AND (`d`.`is_deleted` = false))  ;

