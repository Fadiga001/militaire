CREATE ALGORITHM=UNDEFINED DEFINER=`root`@`localhost` SQL SECURITY DEFINER VIEW `v_condamnations_actives`  AS SELECT `c`.`id` AS `id`, `c`.`numero_dossier` AS `numero_dossier`, `d`.`nom_complet` AS `detenu`, `d`.`matricule` AS `matricule`, `i`.`libelle` AS `infraction`, `c`.`date_jugement` AS `date_jugement`, concat(`c`.`peine_valeur`,' ',`c`.`peine_unite`) AS `peine`, `c`.`date_liberation_effective` AS `date_liberation_effective`, to_days(`c`.`date_liberation_effective`) - to_days(current_timestamp()) AS `jours_restants`, CASE WHEN `c`.`date_liberation_effective` < current_timestamp() THEN 'LIBERABLE' WHEN to_days(`c`.`date_liberation_effective`) - to_days(current_timestamp()) <= 1 THEN 'CRITIQUE' WHEN to_days(`c`.`date_liberation_effective`) - to_days(current_timestamp()) <= 7 THEN 'URGENT' WHEN to_days(`c`.`date_liberation_effective`) - to_days(current_timestamp()) <= 14 THEN 'ATTENTION' WHEN to_days(`c`.`date_liberation_effective`) - to_days(current_timestamp()) <= 30 THEN 'A_SUIVRE' ELSE 'NORMAL' END AS `statut_alerte`, `l`.`nom` AS `lieu_detention`, `c`.`statut` AS `statut` FROM (((`condamnations` `c` join `detenus` `d` on(`c`.`detenu_id` = `d`.`id`)) join `infractions` `i` on(`c`.`infraction_id` = `i`.`id`)) left join `lieux_detention` `l` on(`c`.`lieu_detention_id` = `l`.`id`)) WHERE `c`.`statut` = 'EN_COURS' AND `c`.`is_deleted` = 0 AND `d`.`is_deleted` = 0 ;

