CREATE DEFINER=`root`@`localhost` FUNCTION `fn_jours_restants_detention_preventive` (`p_condamnation_id` INT) RETURNS INT(11) DETERMINISTIC BEGIN
    DECLARE v_jours INT;
    
    SELECT DATEDIFF(date_limite_detention_preventive, NOW())
    INTO v_jours
    FROM condamnations
    WHERE id = p_condamnation_id
      AND est_en_detention_preventive = TRUE;
    
    RETURN COALESCE(v_jours, 0);
END$$

