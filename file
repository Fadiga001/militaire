        p_detenu_id,
        p_infraction_id,
        p_date_jugement,
        p_numero_jugement,
        p_tribunal,
        p_peine_valeur,
        p_peine_unite,
        p_lieu_detention_id,
        p_date_jugement,
        'EN_COURS',
        CONCAT('CONDAMNATION DIRECTE (sans detention provisoire prealable)\n',
               'Juge le ', DATE_FORMAT(p_date_jugement, '%d/%m/%Y'), '\n',
               'Pas de detention provisoire - Execution immediate de la peine'),
        p_user_id
    );
    
    SET v_condamnation_id = LAST_INSERT_ID();
    
    -- Mettre à jour le statut du détenu
    UPDATE detenus
    SET statut_actuel = 'CONDAMNE',
        nombre_condamnations = nombre_condamnations + 1,
        is_multrecidiviste = (nombre_condamnations + 1 > 1),
        date_changement_statut = NOW(),
        updated_by = p_user_id
    WHERE id = p_detenu_id;
    
    -- Créer la période d'exécution
    INSERT INTO periodes_detention (
        detenu_id,
        condamnation_id,
        type,
        motif,
        date_debut,
        lieu_detention_id,
        observations,
        created_by
    ) VALUES (
        p_detenu_id,
        v_condamnation_id,
        'EXECUTION_PEINE',
        'Execution de peine - Condamnation directe',
        p_date_jugement,
        p_lieu_detention_id,
        'Aucune detention provisoire prealable',
        p_user_id
    );
    
    -- Log d'audit
    INSERT INTO audit_logs (user_id, action, entity_type, entity_id, new_values)
    VALUES (
        p_user_id,
        'CONDAMNATION_DIRECTE',
        'CONDAMNATION',
        v_condamnation_id,
        JSON_OBJECT(
            'detenu', v_nom_detenu,
            'dossier', p_numero_dossier,
            'peine', CONCAT(p_peine_valeur, ' ', p_peine_unite),
            'detention_provisoire', 'NON'
