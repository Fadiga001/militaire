DROP TRIGGER IF EXISTS `trg_periode_detention_before_insert`;
DELIMITER $$
CREATE TRIGGER `trg_periode_detention_before_insert` BEFORE INSERT ON `periodes_detention` FOR EACH ROW BEGIN
    IF NEW.date_fin IS NOT NULL THEN
        SET NEW.duree_jours = DATEDIFF(NEW.date_fin, NEW.date_debut);
    END IF;
END
$$
DELIMITER ;
DROP TRIGGER IF EXISTS `trg_periode_detention_before_update`;
DELIMITER $$
CREATE TRIGGER `trg_periode_detention_before_update` BEFORE UPDATE ON `periodes_detention` FOR EACH ROW BEGIN
    IF NEW.date_fin IS NOT NULL THEN
        SET NEW.duree_jours = DATEDIFF(NEW.date_fin, NEW.date_debut);
    ELSE
        SET NEW.duree_jours = NULL;
    END IF;
END
$$
DELIMITER ;

