        NEW.date_debut_detention,
        NEW.lieu_detention_id,
        NEW.created_by
    );
END
$$
DELIMITER ;
DROP TRIGGER IF EXISTS `trg_detention_provisoire_before_insert`;
DELIMITER $$
CREATE TRIGGER `trg_detention_provisoire_before_insert` BEFORE INSERT ON `detentions_provisoires` FOR EACH ROW BEGIN
    DECLARE v_categorie VARCHAR(20);
    
    -- Récupérer la catégorie de l'infraction
    SELECT categorie INTO v_categorie
    FROM infractions
    WHERE id = NEW.infraction_presume_id;
    
    SET NEW.categorie_infraction = v_categorie;
    
    -- Définir la durée maximale selon la catégorie
    SET NEW.duree_max_mois = CASE v_categorie
        WHEN 'CRIME' THEN 24
        WHEN 'DELIT' THEN 18
        ELSE 6
    END;
    
    -- Calculer la date limite
    SET NEW.date_limite_legale = DATE_ADD(
        NEW.date_debut_detention,
        INTERVAL NEW.duree_max_mois MONTH
    );
    
    -- Si pas de date de début, utiliser la date d'arrestation ou du mandat
    IF NEW.date_debut_detention IS NULL THEN
        SET NEW.date_debut_detention = COALESCE(NEW.date_mandat_depot, NEW.date_arrestation);
        SET NEW.date_limite_legale = DATE_ADD(
            NEW.date_debut_detention,
            INTERVAL NEW.duree_max_mois MONTH
        );
    END IF;
END
$$
DELIMITER ;

