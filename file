DROP PROCEDURE IF EXISTS `sp_convertir_en_condamnation`$$
CREATE DEFINER=`root`@`localhost` PROCEDURE `sp_convertir_en_condamnation` (IN `p_detention_id` INT, IN `p_date_jugement` DATE, IN `p_numero_jugement` VARCHAR(100), IN `p_tribunal` VARCHAR(255), IN `p_peine_valeur` INT, IN `p_peine_unite` ENUM('JOUR','MOIS','ANNEE'), IN `p_user_id` INT)   BEGIN
    DECLARE v_detenu_id INT;
    DECLARE v_infraction_id INT;
    DECLARE v_numero_dossier VARCHAR(50);
    DECLARE v_lieu_detention_id INT;
    DECLARE v_date_debut DATE;
    DECLARE v_jours_dp INT;
    DECLARE v_condamnation_id INT;
    
    START TRANSACTION;
    
    -- Récupérer les infos de la détention provisoire
    SELECT 
        detenu_id, 
        infraction_presume_id, 
        numero_dossier,
        lieu_detention_id,
        date_debut_detention,
        DATEDIFF(CURDATE(), date_debut_detention)
    INTO 
        v_detenu_id, 
        v_infraction_id, 
        v_numero_dossier,
        v_lieu_detention_id,
        v_date_debut,
        v_jours_dp
    FROM detentions_provisoires
    WHERE id = p_detention_id
      AND statut = 'EN_COURS';
    
    IF v_detenu_id IS NULL THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Détention provisoire non trouvée';
    END IF;
    
    -- Créer la condamnation
    INSERT INTO condamnations (
        numero_dossier,
        detenu_id,
        infraction_id,
        date_jugement,
        numero_jugement,
        tribunal,
        peine_valeur,
        peine_unite,
        lieu_detention_id,
        date_debut_execution,
        statut,
        created_by
    ) VALUES (
        v_numero_dossier,
        v_detenu_id,
        v_infraction_id,
        p_date_jugement,
        p_numero_jugement,
        p_tribunal,
        p_peine_valeur,
        p_peine_unite,
        v_lieu_detention_id,
        p_date_jugement,
        'EN_COURS',
        p_user_id
    );
    
    SET v_condamnation_id = LAST_INSERT_ID();
    
    -- Mettre à jour la détention provisoire
    UPDATE detentions_provisoires
    SET statut = 'TERMINE_CONDAMNATION',
