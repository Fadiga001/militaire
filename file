-- ============================================================================
-- 10. VUES
-- ============================================================================

-- Vue des détenus complets
CREATE OR REPLACE VIEW v_detenus_complets AS
SELECT 
    d.id,
    d.matricule,
    d.nom_complet,
    d.date_naissance,
    TIMESTAMPDIFF(YEAR, d.date_naissance, NOW()) AS age,
    d.sexe,
    g.libelle AS grade,
    u.nom AS unite,
    d.statut_actuel,
    d.is_multrecidiviste,
    d.nombre_condamnations,
    d.telephone,
    d.photo_path,
    d.created_at
FROM detenus d
INNER JOIN grades g ON d.grade_id = g.id
INNER JOIN unites u ON d.unite_id = u.id
WHERE d.is_deleted = FALSE;

-- Vue des condamnations actives
CREATE OR REPLACE VIEW v_condamnations_actives AS
SELECT 
    c.id,
    c.numero_dossier,
    d.nom_complet AS detenu,
    d.matricule,
    i.libelle AS infraction,
    c.date_jugement,
    CONCAT(c.peine_valeur, ' ', c.peine_unite) AS peine,
    c.date_liberation_effective,
    DATEDIFF(c.date_liberation_effective, NOW()) AS jours_restants,
    CASE 
        WHEN c.date_liberation_effective < NOW() THEN 'LIBERABLE'
        WHEN DATEDIFF(c.date_liberation_effective, NOW()) <= 1 THEN 'CRITIQUE'
        WHEN DATEDIFF(c.date_liberation_effective, NOW()) <= 7 THEN 'URGENT'
        WHEN DATEDIFF(c.date_liberation_effective, NOW()) <= 14 THEN 'ATTENTION'
        WHEN DATEDIFF(c.date_liberation_effective, NOW()) <= 30 THEN 'A_SUIVRE'
        ELSE 'NORMAL'
    END AS statut_alerte,
    l.nom AS lieu_detention,
    c.statut
FROM condamnations c
INNER JOIN detenus d ON c.detenu_id = d.id
INNER JOIN infractions i ON c.infraction_id = i.id
LEFT JOIN lieux_detention l ON c.lieu_detention_id = l.id
WHERE c.statut = 'EN_COURS' 
  AND c.is_deleted = FALSE
  AND d.is_deleted = FALSE;

-- Vue des statistiques
CREATE OR REPLACE VIEW v_statistiques AS
SELECT 
    (SELECT COUNT(*) FROM detenus WHERE is_deleted = FALSE) AS total_detenus,
    (SELECT COUNT(*) FROM detenus WHERE statut_actuel = 'CONDAMNE' AND is_deleted = FALSE) AS total_condamnes,
    (SELECT COUNT(*) FROM detenus WHERE statut_actuel = 'DETENTION_PROVISOIRE' AND is_deleted = FALSE) AS total_detention_provisoire,
    (SELECT COUNT(*) FROM detenus WHERE statut_actuel = 'LIBRE' AND is_deleted = FALSE) AS total_liberes,
    (SELECT COUNT(*) FROM detenus WHERE is_multrecidiviste = TRUE AND is_deleted = FALSE) AS total_multrecidivistes,
    (SELECT COUNT(*) FROM condamnations WHERE statut = 'EN_COURS' AND is_deleted = FALSE) AS condamnations_actives;

