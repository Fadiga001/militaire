-- ============================================================================

-- Génération automatique du matricule
DELIMITER //
CREATE TRIGGER trg_detenu_before_insert 
BEFORE INSERT ON detenus
FOR EACH ROW
BEGIN
    IF NEW.matricule IS NULL THEN
        SET NEW.matricule = CONCAT(
            'DET',
            YEAR(CURDATE()),
            LPAD((SELECT COALESCE(MAX(id), 0) + 1 FROM detenus), 6, '0')
        );
    END IF;
END//
DELIMITER ;

-- Mise à jour du nombre de condamnations
DELIMITER //
CREATE TRIGGER trg_condamnation_after_insert 
AFTER INSERT ON condamnations
FOR EACH ROW
BEGIN
    UPDATE detenus 
    SET nombre_condamnations = nombre_condamnations + 1,
        is_multrecidiviste = (nombre_condamnations + 1 > 1),
        statut_actuel = 'CONDAMNE'
    WHERE id = NEW.detenu_id;
END//
DELIMITER ;

-- Calcul automatique des dates de libération
DELIMITER //
CREATE TRIGGER trg_condamnation_before_update 
BEFORE UPDATE ON condamnations
FOR EACH ROW
BEGIN
    IF NEW.date_jugement IS NOT NULL AND NEW.peine_valeur > 0 THEN
        -- Date théorique
        SET NEW.date_liberation_theorique = DATE_ADD(
            NEW.date_jugement, 
            INTERVAL NEW.peine_jours_total DAY
        );
        
        -- Jours OIP
        SET NEW.jours_detention_provisoire_oip = COALESCE(
            DATEDIFF(NEW.date_omlp, NEW.date_oip), 0
        );
        
        -- Jours mandat
        IF NEW.date_mandat_depot IS NOT NULL THEN
            SET NEW.jours_detention_provisoire_mandat = DATEDIFF(
                COALESCE(NEW.date_liberation_mandat, NEW.date_jugement),
                NEW.date_mandat_depot
            );
        ELSE
            SET NEW.jours_detention_provisoire_mandat = 0;
        END IF;
        
        -- Date effective
        SET NEW.date_liberation_effective = DATE_SUB(
            NEW.date_liberation_theorique,
            INTERVAL NEW.jours_detention_provisoire_total DAY
        );
    END IF;
END//
DELIMITER ;

-- Trigger pour calculer la durée des périodes de détention
DELIMITER //
CREATE TRIGGER trg_periode_detention_before_insert
BEFORE INSERT ON periodes_detention
FOR EACH ROW
BEGIN
    IF NEW.date_fin IS NOT NULL THEN
        SET NEW.duree_jours = DATEDIFF(NEW.date_fin, NEW.date_debut);
    END IF;
END//
DELIMITER ;

DELIMITER //
CREATE TRIGGER trg_periode_detention_before_update
BEFORE UPDATE ON periodes_detention
FOR EACH ROW
BEGIN
    IF NEW.date_fin IS NOT NULL THEN
        SET NEW.duree_jours = DATEDIFF(NEW.date_fin, NEW.date_debut);
    ELSE
        SET NEW.duree_jours = NULL;
    END IF;
END//
DELIMITER ;

