CREATE DEFINER=`root`@`localhost` PROCEDURE `sp_convertir_en_condamnation` (IN `p_detention_id` INT, IN `p_date_jugement` DATE, IN `p_numero_jugement` VARCHAR(100), IN `p_tribunal` VARCHAR(255), IN `p_peine_valeur` INT, IN `p_peine_unite` ENUM('JOUR','MOIS','ANNEE'), IN `p_user_id` INT)   BEGIN
    DECLARE v_detenu_id INT;
    DECLARE v_infraction_id INT;
    DECLARE v_numero_dossier VARCHAR(50);
    DECLARE v_lieu_detention_id INT;
    DECLARE v_date_debut DATE;
    DECLARE v_jours_dp INT;
    DECLARE v_condamnation_id INT;
    
    START TRANSACTION;
    
    -- Récupérer les infos de la détention provisoire
    SELECT 
        detenu_id, 
        infraction_presume_id, 
        numero_dossier,
        lieu_detention_id,
        date_debut_detention,
        DATEDIFF(CURDATE(), date_debut_detention)
    INTO 
        v_detenu_id, 
        v_infraction_id, 
        v_numero_dossier,
        v_lieu_detention_id,
        v_date_debut,
        v_jours_dp
    FROM detentions_provisoires
    WHERE id = p_detention_id
      AND statut = 'EN_COURS';
    
    IF v_detenu_id IS NULL THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Détention provisoire non trouvée';
    END IF;
    
    -- Créer la condamnation
    INSERT INTO condamnations (
        numero_dossier,
        detenu_id,
        infraction_id,
        date_jugement,
        numero_jugement,
        tribunal,
        peine_valeur,
        peine_unite,
        lieu_detention_id,
        date_debut_execution,
        statut,
        created_by
    ) VALUES (
        v_numero_dossier,
        v_detenu_id,
        v_infraction_id,
        p_date_jugement,
        p_numero_jugement,
        p_tribunal,
        p_peine_valeur,
        p_peine_unite,
        v_lieu_detention_id,
        p_date_jugement,
        'EN_COURS',
        p_user_id
    );
    
    SET v_condamnation_id = LAST_INSERT_ID();
    
    -- Mettre à jour la détention provisoire
    UPDATE detentions_provisoires
    SET statut = 'TERMINE_CONDAMNATION',
        date_fin = p_date_jugement,
        condamnation_id = v_condamnation_id,
        motif_fin = CONCAT('Condamné - Jugement du ', DATE_FORMAT(p_date_jugement, '%d/%m/%Y')),
        updated_by = p_user_id
    WHERE id = p_detention_id;
    
    -- Mettre à jour le détenu
    UPDATE detenus
    SET statut_actuel = 'CONDAMNE',
        nombre_condamnations = nombre_condamnations + 1,
        is_multrecidiviste = (nombre_condamnations + 1 > 1),
        date_changement_statut = NOW(),
        updated_by = p_user_id
    WHERE id = v_detenu_id;
    
    -- Fermer l'ancienne période et en créer une nouvelle
    UPDATE periodes_detention
    SET date_fin = p_date_jugement
    WHERE detenu_id = v_detenu_id
      AND type = 'DETENTION_PROVISOIRE'
      AND date_fin IS NULL;
    
    INSERT INTO periodes_detention (
        detenu_id,
        condamnation_id,
        type,
        motif,
        date_debut,
        lieu_detention_id,
        created_by
    ) VALUES (
        v_detenu_id,
        v_condamnation_id,
        'EXECUTION_PEINE',
        'Exécution de peine',
        p_date_jugement,
        v_lieu_detention_id,
        p_user_id
    );
    
    -- Log d'audit
    INSERT INTO audit_logs (user_id, action, entity_type, entity_id, new_values)
    VALUES (
        p_user_id,
        'CONVERSION_CONDAMNATION',
        'DETENTION_PROVISOIRE',
        p_detention_id,
        JSON_OBJECT(
            'condamnation_id', v_condamnation_id,
            'jours_detention_provisoire', v_jours_dp
        )
    );
    
    COMMIT;
    
    SELECT 
        '✅ Conversion en condamnation réussie' AS message,
        v_condamnation_id AS condamnation_id,
        v_jours_dp AS jours_detention_provisoire_deduits,
        DATE_FORMAT(p_date_jugement, '%d/%m/%Y') AS date_jugement;
END$$

CREATE DEFINER=`root`@`localhost` PROCEDURE `sp_creer_condamnation_directe` (IN `p_detenu_id` INT, IN `p_numero_dossier` VARCHAR(50), IN `p_infraction_id` INT, IN `p_date_jugement` DATE, IN `p_numero_jugement` VARCHAR(100), IN `p_tribunal` VARCHAR(255), IN `p_peine_valeur` INT, IN `p_peine_unite` ENUM('JOUR','MOIS','ANNEE'), IN `p_lieu_detention_id` INT, IN `p_user_id` INT)   BEGIN
    DECLARE v_condamnation_id INT;
    DECLARE v_nom_detenu VARCHAR(355);
    DECLARE v_statut_actuel VARCHAR(50);
    
    START TRANSACTION;
    
    -- Vérifier que le détenu existe
    SELECT nom_complet, statut_actuel
    INTO v_nom_detenu, v_statut_actuel
    FROM detenus
    WHERE id = p_detenu_id
      AND is_deleted = FALSE;
    
    IF v_nom_detenu IS NULL THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Detenu non trouve';
    END IF;
    
    -- Vérifier que le numéro de dossier n'existe pas déjà
    IF EXISTS (SELECT 1 FROM condamnations WHERE numero_dossier = p_numero_dossier) THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Numero de dossier deja existant dans les condamnations';
    END IF;
    
    IF EXISTS (SELECT 1 FROM detentions_provisoires WHERE numero_dossier = p_numero_dossier) THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Numero de dossier deja existant dans les detentions provisoires';
    END IF;
    
    -- Créer la condamnation DIRECTEMENT
    INSERT INTO condamnations (
        numero_dossier,
        detenu_id,
        infraction_id,
        date_jugement,
        numero_jugement,
        tribunal,
