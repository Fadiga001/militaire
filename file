        'Aucune detention provisoire prealable' AS note;
END$$

CREATE DEFINER=`root`@`localhost` PROCEDURE `sp_generer_notifications` ()   BEGIN
    DECLARE v_date_limite DATE;
    SET v_date_limite = DATE_SUB(NOW(), INTERVAL 30 DAY);
    
    -- Supprimer les anciennes notifications
    DELETE FROM notifications 
    WHERE created_at < v_date_limite;
    
    -- Générer nouvelles notifications
    INSERT INTO notifications (type, urgence, entity_type, entity_id, titre, message, date_evenement, jours_avant)
    SELECT 
        'LIBERATION_IMMINENTE',
        CASE 
            WHEN jours_restants <= 1 THEN 'CRITICAL'
            WHEN jours_restants <= 7 THEN 'HIGH'
            WHEN jours_restants <= 14 THEN 'MEDIUM'
            ELSE 'LOW'
        END,
        'CONDAMNATION',
        id,
        CONCAT('Libération imminente: ', detenu),
        CONCAT('Date de libération prévue: ', DATE_FORMAT(date_liberation_effective, '%d/%m/%Y')),
        date_liberation_effective,
        jours_restants
    FROM v_condamnations_actives
    WHERE jours_restants BETWEEN 0 AND 30
      AND NOT EXISTS (
          SELECT 1 FROM notifications 
          WHERE entity_type = 'CONDAMNATION' 
            AND entity_id = v_condamnations_actives.id
            AND is_active = TRUE
            AND DATE(created_at) = DATE(NOW())
      );
END$$

CREATE DEFINER=`root`@`localhost` PROCEDURE `sp_liberer_condamne` (IN `p_condamnation_id` INT, IN `p_user_id` INT, IN `p_motif` VARCHAR(255))   BEGIN
    DECLARE v_detenu_id INT;
    
    START TRANSACTION;
    
    -- Récupérer l'ID du détenu
    SELECT detenu_id INTO v_detenu_id
    FROM condamnations
    WHERE id = p_condamnation_id;
    
    -- Mettre à jour la condamnation
    UPDATE condamnations
    SET statut = 'TERMINEE',
        date_liberation_reelle = NOW(),
        motif_liberation = p_motif,
        updated_by = p_user_id
    WHERE id = p_condamnation_id;
    
    -- Mettre à jour le détenu si c'est sa dernière condamnation
    UPDATE detenus
    SET statut_actuel = 'LIBRE',
        date_changement_statut = NOW(),
        updated_by = p_user_id
    WHERE id = v_detenu_id
      AND NOT EXISTS (
          SELECT 1 FROM condamnations 
          WHERE detenu_id = v_detenu_id 
            AND statut = 'EN_COURS'
            AND id != p_condamnation_id
      );
    
    COMMIT;
END$$

CREATE DEFINER=`root`@`localhost` PROCEDURE `sp_liberer_detention_preventive` (IN `p_condamnation_id` INT, IN `p_user_id` INT, IN `p_motif` VARCHAR(255))   BEGIN
    DECLARE v_detenu_id INT;
    DECLARE v_date_limite DATE;
    
    START TRANSACTION;
    
    -- Vérifier que c'est bien une détention préventive
    SELECT detenu_id, date_limite_detention_preventive
    INTO v_detenu_id, v_date_limite
    FROM condamnations
    WHERE id = p_condamnation_id
      AND est_en_detention_preventive = TRUE;
    
    IF v_detenu_id IS NULL THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Cette condamnation n\'est pas en détention préventive';
    END IF;
    
    -- Vérifier que la date limite est dépassée
    IF v_date_limite >= NOW() THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'La date limite de détention préventive n\'est pas encore atteinte';
    END IF;
    
    -- Mettre à jour la condamnation
    UPDATE condamnations
    SET statut = 'ANNULEE',
        est_en_detention_preventive = FALSE,
        date_liberation_reelle = NOW(),
        motif_liberation = CONCAT('Fin détention préventive - ', p_motif),
        updated_by = p_user_id
    WHERE id = p_condamnation_id;
    
    -- Mettre à jour le détenu
    UPDATE detenus
    SET statut_actuel = 'LIBRE',
        date_changement_statut = NOW(),
        updated_by = p_user_id
    WHERE id = v_detenu_id
      AND NOT EXISTS (
          SELECT 1 FROM condamnations 
          WHERE detenu_id = v_detenu_id 
            AND statut = 'EN_COURS'
            AND id != p_condamnation_id
      );
    
    -- Fermer la période de détention
    UPDATE periodes_detention
    SET date_fin = NOW()
    WHERE detenu_id = v_detenu_id
      AND condamnation_id = p_condamnation_id
      AND date_fin IS NULL;
    
    -- Créer un log d'audit
    INSERT INTO audit_logs (user_id, action, entity_type, entity_id, new_values)
    VALUES (
        p_user_id,
        'LIBERATION_DETENTION_PREVENTIVE',
        'CONDAMNATION',
        p_condamnation_id,
        JSON_OBJECT(
            'motif', p_motif,
            'date_liberation', NOW(),
            'date_limite_depassee', v_date_limite
        )
    );
    
    COMMIT;
    
    SELECT 'Détenu libéré avec succès' AS Message;
END$$

CREATE DEFINER=`root`@`localhost` PROCEDURE `sp_liberer_detention_provisoire` (IN `p_detention_id` INT, IN `p_user_id` INT, IN `p_motif` TEXT)   BEGIN
    DECLARE v_detenu_id INT;
    DECLARE v_date_limite DATE;
    DECLARE v_jours_restants INT;
    
    START TRANSACTION;
    
    -- Récupérer les infos
    SELECT 
        detenu_id, 
        date_limite_legale, 
        DATEDIFF(date_limite_legale, CURDATE())
    INTO v_detenu_id, v_date_limite, v_jours_restants
    FROM detentions_provisoires
    WHERE id = p_detention_id
      AND statut = 'EN_COURS';
    
    IF v_detenu_id IS NULL THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Détention provisoire non trouvée ou déjà terminée';
    END IF;
    
    -- Mettre à jour la détention provisoire
    UPDATE detentions_provisoires
    SET statut = 'TERMINE_LIBERATION',
        date_fin = CURDATE(),
        motif_fin = p_motif,
        updated_by = p_user_id
    WHERE id = p_detention_id;
    
    -- Mettre à jour le détenu
    UPDATE detenus
    SET statut_actuel = 'LIBRE',
        date_changement_statut = NOW(),
        updated_by = p_user_id
    WHERE id = v_detenu_id;
    
    -- Fermer la période de détention
    UPDATE periodes_detention
    SET date_fin = CURDATE()
    WHERE detenu_id = v_detenu_id
      AND type = 'DETENTION_PROVISOIRE'
      AND date_fin IS NULL;
    
    -- Log d'audit
    INSERT INTO audit_logs (user_id, action, entity_type, entity_id, new_values)
    VALUES (
        p_user_id,
        'LIBERATION_DETENTION_PROVISOIRE',
        'DETENTION_PROVISOIRE',
        p_detention_id,
        JSON_OBJECT(
            'motif', p_motif,
            'date_liberation', CURDATE(),
            'date_limite', v_date_limite,
            'jours_restants', v_jours_restants
        )
    );
    
    COMMIT;
    
    SELECT 
        '✅ Détenu libéré avec succès' AS message,
        v_detenu_id AS detenu_id,
        v_jours_restants AS jours_restants_liberation,
        DATE_FORMAT(CURDATE(), '%d/%m/%Y') AS date_liberation;
END$$

CREATE DEFINER=`root`@`localhost` PROCEDURE `sp_verifier_detentions_preventives` ()   BEGIN
    DECLARE done INT DEFAULT FALSE;
    DECLARE v_condamnation_id INT;
    DECLARE v_detenu_id INT;
    DECLARE v_numero_dossier VARCHAR(50);
    
    -- Curseur pour les détentions préventives dépassées
    DECLARE cur CURSOR FOR
        SELECT c.id, c.detenu_id, c.numero_dossier
        FROM condamnations c
        WHERE c.est_en_detention_preventive = TRUE
          AND c.date_limite_detention_preventive < NOW()
          AND c.statut = 'EN_COURS'
          AND c.is_deleted = FALSE;
    
    DECLARE CONTINUE HANDLER FOR NOT FOUND SET done = TRUE;
    
    OPEN cur;
    
    read_loop: LOOP
        FETCH cur INTO v_condamnation_id, v_detenu_id, v_numero_dossier;
        
        IF done THEN
            LEAVE read_loop;
        END IF;
        
        -- Créer une notification critique
        INSERT INTO notifications (
            type, 
            urgence, 
            entity_type, 
            entity_id, 
            titre, 
            message
        ) VALUES (
            'FIN_DETENTION_PROVISOIRE',
            'CRITICAL',
            'CONDAMNATION',
            v_condamnation_id,
            CONCAT('URGENT: Limite détention préventive dépassée - Dossier ', v_numero_dossier),
            'La durée maximale de détention préventive est dépassée. Libération obligatoire ou jugement immédiat requis.'
        );
        
    END LOOP;
    
    CLOSE cur;
    
    -- Retourner le nombre de cas critiques
    SELECT COUNT(*) AS nb_cas_critiques
    FROM condamnations
    WHERE est_en_detention_preventive = TRUE
      AND date_limite_detention_preventive < NOW()
      AND statut = 'EN_COURS'
      AND is_deleted = FALSE;
END$$

CREATE DEFINER=`root`@`localhost` PROCEDURE `sp_verifier_detentions_provisoires` ()   BEGIN
    -- Générer des notifications pour les détentions critiques
    INSERT INTO notifications (
        type,
        urgence,
        entity_type,
        entity_id,
        titre,
        message,
        date_evenement,
        jours_avant
    )
    SELECT 
        'FIN_DETENTION_PROVISOIRE',
        CASE 
            WHEN jours_restants < 0 THEN 'CRITICAL'
            WHEN jours_restants <= 3 THEN 'CRITICAL'
            WHEN jours_restants <= 7 THEN 'HIGH'
            WHEN jours_restants <= 30 THEN 'MEDIUM'
            ELSE 'LOW'
        END,
        'DETENTION_PROVISOIRE',
        id,
        CONCAT('Detention provisoire - ', detenu, ' (', numero_dossier, ')'),
        CASE 
            WHEN jours_restants < 0 THEN 
                CONCAT('URGENT: Limite depassee de ', ABS(jours_restants), ' jours. Liberation obligatoire!\n',
                       'Commande: CALL sp_liberer_detention_provisoire(', id, ', user_id, \'Depassement delai legal\')')
            ELSE 
                CONCAT('Fin de detention provisoire dans ', jours_restants, ' jours.\n',
                       'Date limite: ', DATE_FORMAT(date_limite_legale, '%d/%m/%Y'), '\n',
                       'Duree actuelle: ', jours_detention_actuel, ' jours (', ROUND(pourcentage_duree, 1), '%)')
        END,
        date_limite_legale,
        jours_restants
    FROM v_detentions_provisoires
    WHERE jours_restants <= 30
      AND NOT EXISTS (
          SELECT 1 FROM notifications 
          WHERE entity_type = 'DETENTION_PROVISOIRE' 
            AND entity_id = v_detentions_provisoires.id
            AND DATE(created_at) = CURDATE()
      );
    
    -- Retourner le résumé
    SELECT 
        'RESUME DETENTIONS PROVISOIRES' AS titre,
        COUNT(*) AS total_detentions,
        SUM(CASE WHEN jours_restants < 0 THEN 1 ELSE 0 END) AS Depassees,
        SUM(CASE WHEN jours_restants BETWEEN 0 AND 3 THEN 1 ELSE 0 END) AS Critiques,
        SUM(CASE WHEN jours_restants BETWEEN 4 AND 7 THEN 1 ELSE 0 END) AS Urgentes,
        SUM(CASE WHEN jours_restants BETWEEN 8 AND 30 THEN 1 ELSE 0 END) AS Attention,
        ROUND(AVG(pourcentage_duree), 1) AS 'Moy_Avancement_Pourcent'
    FROM v_detentions_provisoires;
END$$

