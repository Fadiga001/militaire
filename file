-- ============================================================================
-- 8. NOTIFICATIONS
-- ============================================================================

CREATE TABLE notifications (
    id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
    
    type ENUM('LIBERATION_IMMINENTE', 'FIN_DETENTION_PROVISOIRE', 'DOCUMENT_MANQUANT', 'AUTRE') NOT NULL,
    urgence ENUM('INFO', 'LOW', 'MEDIUM', 'HIGH', 'CRITICAL') NOT NULL DEFAULT 'INFO',
    
    entity_type ENUM('DETENU', 'CONDAMNATION') NOT NULL,
    entity_id INT UNSIGNED NOT NULL,
    
    titre VARCHAR(255) NOT NULL,
    message TEXT NOT NULL,
    
    date_evenement DATE,
    jours_avant INT,
    
